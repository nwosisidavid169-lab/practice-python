import argparse

parser = argparse.ArgumentParser(description="Clean a file")

parser.add_argument("-i", "--input", required=True)
parser.add_argument("-o", "--output", required=True)

args = parser.parse_args()


# General file cleaner
def clean_line(line):
    return " ".join(line.split()).title()


# Email file cleaner
def clean_email(line):
    return " ".join(line.split()).lower()


# Ask the user which cleaner to use
print("Choose a cleaner:")
print("1. General File Cleaner")
print("2. Email File Cleaner")

choice = input("Enter your choice: ")


# Read the input file
with open(args.input, "r") as file:
    lines = file.readlines()


seen = []
clean = []


# Clean each line
for line in lines:

    if choice == "1":
        line = clean_line(line)

    elif choice == "2":
        line = clean_email(line)

    else:
        print("Invalid choice.")
        exit()

    # Skip empty lines
    if line == "":
        continue

    # Skip duplicates
    if line in seen:
        continue

    seen.append(line)
    clean.append(line + "\n")


# Write the cleaned file
with open(args.output, "w") as file:
    file.writelines(clean)


print(f"Cleaned {len(lines)} lines down to {len(clean)}.")