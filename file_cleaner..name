import argparse


# Create a command-line argument parser
parser = argparse.ArgumentParser(
    description="Clean a file"
)

# Tell the program which input and output files to use
parser.add_argument("-i", "--input", required=True)
parser.add_argument("-o", "--output", required=True)

# Read the arguments supplied in the terminal
args = parser.parse_args()


def clean_line(line):
    """
    Clean a line by removing extra spaces
    and capitalizing each word.
    """
    return " ".join(line.split()).title()


# Open the input file and read all its lines
with open(args.input, "r") as f:
    lines = f.readlines()


# Keep track of names we have already seen
seen = []

# Store the final cleaned lines
clean = []


# Process each line in the input file
for line in lines:
    line = clean_line(line)

    # Skip empty lines
    if line == "":
        continue

    # Skip duplicate lines
    if line in seen:
        continue

    # Remember this line so duplicates can be detected
    seen.append(line)

    # Add the cleaned line to the final list
    clean.append(line + "\n")


# Open the output file and write the cleaned lines
with open(args.output, "w") as f:
    f.writelines(clean)


# Show the cleaning result
print(f"Cleaned {len(lines)} lines down to {len(clean)}.")