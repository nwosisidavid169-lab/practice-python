# ============================================================
# OPERATOR OVERLOADING
# ============================================================

# Operator overloading allows us to define how operators
# such as >, <, == and + work with objects.


class Dog:
    def __init__(self, name, age):
        self.name = name
        self.age = age

    # > (greater than)
    def __gt__(self, other):
        return self.age > other.age

    # < (less than)
    def __lt__(self, other):
        return self.age < other.age

    # == (equal to)
    def __eq__(self, other):
        return self.age == other.age

    # + (addition)
    def __add__(self, other):
        return self.age + other.age


# ------------------------------------------------------------
# Creating Dog objects
# ------------------------------------------------------------

roger = Dog("Roger", 9)
syd = Dog("Syd", 10)
bingo = Dog("Bingo", 9)


# ------------------------------------------------------------
# Using the overloaded operators
# ------------------------------------------------------------

print("Is Roger older than Syd?")
print(roger > syd)

print("\nIs Roger younger than Syd?")
print(roger < syd)

print("\nAre Roger and Bingo the same age?")
print(roger == bingo)

print("\nCombined age of Roger and Syd:")
print(roger + syd)


# ------------------------------------------------------------
# Using a list
# ------------------------------------------------------------

dogs = [roger, syd, bingo]

print("\nDogs in the list:")

for dog in dogs:
    print(dog.name, dog.age)